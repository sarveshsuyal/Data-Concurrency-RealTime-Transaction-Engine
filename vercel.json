{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://datacore-backend-wktd.onrender.com/api/$1"
    },
    {
      "source": "/health",
      "destination": "https://datacore-backend-wktd.onrender.com/health/"
    },
    {
      "source": "/health/",
      "destination": "https://datacore-backend-wktd.onrender.com/health/"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
